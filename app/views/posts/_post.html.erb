<div class="col-6" style="margin: 0 auto">
<div class="card text-bg-dark" id="<%= dom_id post %>" style="width: 18rem;">
  <% post.images.each do |image| %>
    <%= image_tag(image, class: "post-img") %>
  <% end %>
  <div class="card-body">
    <h5 class="card-title"><%= post.title %></h5>
    <p class="card-text"><%= post.description %></p>
    <% if user_signed_in? %>
      <% like = current_user.likes.find_by(post: post) %>
      <% if like.nil? %>
        <%= button_to "like", likes_path, params: {like: { post_id: post.id}}, method: :post %>
      <% else %>
        <%= button_to "Unlike", like_path(like), method: :delete %>
      <% end %>
    <% end %>
      <%= post.likes.count  %>
  </div>
  <ul class="list-group list-group-flush">
    <li class="list-group-item"><%= post.user.email %></li>
    <li class="list-group-item"><%= post.keywords %></li>
    <%# <li class="list-group-item">A third item</li> %>
  </ul>
  <div class="card-body">
    <%= link_to post.user.email, post.user %>
    <a href="#" class="card-link">Another link</a>
  </div>
</div>
</div>